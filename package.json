{
    "name": "@starframe/rune-map",
    "version": "0.2.0",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./server": {
            "import": "./dist/server/index.js",
            "types": "./dist/server/index.d.ts"
        },
        "./client": {
            "import": "./dist/client/index.js",
            "types": "./dist/client/index.d.ts"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "server": "node dist/server/index.js",
        "client": "node dist/client/index.js"
    },
    "bin": {
        "rune-map": "dist/client/index.js"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/ws": "^8.5.13",
        "typescript": "^5.7.0",
        "vitest": "^2.1.0"
    }
}
